# Copy this file to `.env` and fill in your key, or export these in your shell.
# (cli.py / streamlit read ANTHROPIC_API_KEY from the environment.)

# Required: your Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional tuning (defaults shown). The program team can change these without
# touching code — see RUNBOOK.md.
# BENEFIT_NAV_MODEL=claude-opus-4-8      # or claude-sonnet-4-6 for lower cost
# BENEFIT_NAV_EFFORT=medium              # low | medium | high
# BENEFIT_NAV_MAX_TOKENS=4096
# BENEFIT_NAV_MAX_TOOL_ITERS=6
# BENEFIT_NAV_JUDGE_MODEL=claude-opus-4-8
